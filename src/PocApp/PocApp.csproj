<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
	  <PackageReference Include="Syncfusion.Licensing" />
	  <PackageReference Include="Syncfusion.Chart.Windows" />
    <PackageReference Include="Syncfusion.Gauge.Windows" />
    <PackageReference Include="Syncfusion.Tools.Windows" />
    <PackageReference Include="Syncfusion.Diagram.Windows" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HmiControls\HmiControls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- iocomp reference images, shown beside each Syncfusion control -->
    <Content Include="..\..\iocomp-dotnet-images\*.png" Link="iocomp-dotnet-images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
